{
  "name": "flare",
  "private": true,
  "workspaces": ["apps/*"],
  "scripts": {
    "dev:api": "bun run --cwd apps/api dev",
    "dev:web": "bun run --cwd apps/web dev",
    "dev:worker": "bun run --cwd apps/worker dev",
    "dev:shop-api": "bun run --cwd apps/shop-api dev",
    "dev:shop-worker": "bun run --cwd apps/shop-worker dev",
    "build:web": "bun run --cwd apps/web build",
    "build:api": "bun run --cwd apps/api build",
    "build:worker": "bun run --cwd apps/worker build",
    "check": "bun run --cwd apps/api check && bun run --cwd apps/worker check && bun run --cwd apps/shop-api check"
  }
}
